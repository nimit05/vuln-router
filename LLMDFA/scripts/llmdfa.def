Bootstrap: docker
From: vllm/vllm-openai:v0.27.1

# Container for the LLMDFA (NeurIPS 2024) reproduction on csecluster.
#
# Two Python environments live inside on purpose:
#   * the image's system python  -> vLLM server (torch, CUDA)
#   * /opt/llmdfa-venv           -> LLMDFA client (tree-sitter 0.20.2, z3, openai)
# LLMDFA pins tree-sitter==0.20.2, whose Language.build_library() API was removed
# in 0.21. Installing its requirements into the vLLM env would drag in torch==2.4.0
# and break the server, hence the split.

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends git build-essential curl ca-certificates
    apt-get clean && rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/llmdfa-venv
    /opt/llmdfa-venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/llmdfa-venv/bin/pip install --no-cache-dir \
        "openai==1.51.0" \
        "tiktoken==0.7.0" \
        "tree-sitter==0.20.2" \
        "z3-solver==4.13.0.0" \
        "requests==2.31.0"

    # Pre-build the tree-sitter Java grammar at BUILD time; compute nodes may have
    # no network, and lib/build.py would try to git clone at run time.
    mkdir -p /opt/ts/build
    git clone https://github.com/tree-sitter/tree-sitter-java.git /opt/ts/vendor/tree-sitter-java
    cd /opt/ts/vendor/tree-sitter-java
    git checkout 490d878cf33b0ad5ae7a7253ff30597a5bdc348e
    /opt/llmdfa-venv/bin/python -c \
        "from tree_sitter import Language; Language.build_library('/opt/ts/build/my-languages.so', ['/opt/ts/vendor/tree-sitter-java'])"
    test -f /opt/ts/build/my-languages.so

%environment
    export LLMDFA_PY=/opt/llmdfa-venv/bin/python
    export LLMDFA_TS_SO=/opt/ts/build/my-languages.so
    export LC_ALL=C

%labels
    Description "vLLM + LLMDFA client for csecluster (gpu-A100)"

%help
    vLLM server:  python3 -m vllm.entrypoints.openai.api_server --model <hf-id>
    LLMDFA:       $LLMDFA_PY run_llmdfa.py --bug-type xss --model-name <served-name>
    Java grammar: copy $LLMDFA_TS_SO into LLMDFA/lib/build/my-languages.so
