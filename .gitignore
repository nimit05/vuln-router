# Heavy, re-creatable IRIS artifacts (~60G on the GPU box)
IRIS/data/
IRIS/.conda-iris/
IRIS/codeql/
IRIS/output/
codeql-home/
*codeql-db*/
*.codeqldb/
project-sources/
java-env/

# Model weights / archives
*.safetensors
*.gguf
*.pt
*.pth
*.jar
*.nar
*.tar.gz
*.zip

# Upstream IRIS ignores
patch_info
projects
projects-gh
commit_data
old
outputs*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Local tooling / OS
.claude/
.DS_Store
.idea/
.vscode/

# LLMDFA per-case artifacts (5,169 report.json + 2,582 transformed .java inputs,
# ~54MB). Not needed for any published number: the results table is computed from
# LLMDFA/reproduction/logs/ alone. Full copies live on csecluster at ~/job_results/.
LLMDFA/reproduction/logs_artifacts/
LLMDFA/results/job_artifacts/
.venv/

# Juliet benchmark from the upstream LLMDFA repo (not vendored, re-clonable)
LLMDFA/benchmark/

# Duplicate of the tracked IRIS/reproduction/ tree (byte-identical). Left on disk
# so the results/<paper>/ layout stays browsable; the canonical copy is versioned
# under IRIS/reproduction/.
/results/

# Local GPU-box mirror tooling and its rsync log. The GPU box is out of the loop
# (all runs are on csecluster), so this is machine-local, not a repo artifact.
gpu-backup/
gpu-backup-sync.log
gpu-backup-sync.sh

# Exploratory model/offset sweep output (score_probe.py --logdir). Nothing in the
# results table or ROUTER_*.md is computed from it; logs_router/ carries the
# router evidence. Kept on disk so score_probe.py runs locally unchanged.
LLMDFA/reproduction/logs_probe/
